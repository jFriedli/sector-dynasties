{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sector Dynasties",
  "version": "0.1.0",
  "identifier": "dev.jfriedli.sector-dynasties",
  "build": {
    "beforeDevCommand": "npm run build:wasm && npm run dev",
    "beforeBuildCommand": "npm run build:wasm && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sector Dynasties",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
